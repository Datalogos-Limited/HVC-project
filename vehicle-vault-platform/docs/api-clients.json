  "components": {
    "schemas": {
      "Client": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "individual",
              "company",
              "trust",
              "family_office"
            ],
            "title": "Entity Type"
          },
          "domicile": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "title": "Domicile"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "entity_type",
          "domicile"
        ],
        "title": "Client"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "format": "password",
            "title": "Password",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "DocumentCreate": {
        "properties": {
          "parent_id": {
            "type": "string",
            "format": "uuid",
            "title": "Parent Id"
          },
          "filename": {
            "type": "string",
            "maxLength": 180,
            "minLength": 1,
            "pattern": "^[^/\\\\\\x00-\\x1f]+$",
            "title": "Filename"
          },
          "category": {
            "type": "string",
            "enum": [
              "identity",
              "address",
              "source_of_funds",
              "mandate",
              "title",
              "insurance",
              "valuation",
              "service",
              "inspection",
              "contract",
              "bank_statement",
              "other"
            ],
            "title": "Category"
          },
          "content_type": {
            "type": "string",
            "enum": [
              "application/pdf",
              "image/jpeg",
              "image/png"
            ],
            "title": "Content Type"
          },
          "size_bytes": {
            "type": "integer",
            "maximum": 20971520.0,
            "exclusiveMinimum": 0.0,
            "title": "Size Bytes"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Sha256"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "parent_id",
          "filename",
          "category",
          "content_type",
          "size_bytes",
          "sha256"
        ],
        "title": "DocumentCreate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IdentityResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid",
            "title": "Tenant Id"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Roles"
          },
          "client_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id",
          "tenant_id",
          "roles",
          "client_id"
        ],
        "title": "IdentityResponse"
      },
      "RecordEnvelope": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "client_id": {
            "type": "string",
            "format": "uuid",
            "title": "Client Id"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "client_id",
          "version",
          "created_at",
          "data"
        ],
        "title": "RecordEnvelope"
      },
      "RecordPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RecordEnvelope"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "RecordPage"
      },
      "SignIn": {
        "properties": {
          "email": {
